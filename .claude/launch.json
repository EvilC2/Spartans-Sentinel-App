{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sentinel-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "sentinel-metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "sentinel-web-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_SUPABASE_URL=",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY=",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "port": 8083
    },
    {
      "name": "sentinel-metro-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_SUPABASE_URL=",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY=",
        "npx",
        "expo",
        "start",
        "--port",
        "8084"
      ],
      "port": 8084
    }
  ]
}
