{
  "expo": {
    "name": "Spartans",
    "slug": "spartans",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clivebrownhill.spartans",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sentinel.schoolapp",
      "adaptiveIcon": {
        "backgroundColor": "#021F6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Spartans uses the camera to scan your student ID card and take your ID photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spartans needs your photos to pick your ID photo.",
          "cameraPermission": "Spartans uses the camera to take your ID photo."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Spartans tilts badges with your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A3A5C"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Spartans saves badge pictures to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#021F6B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
