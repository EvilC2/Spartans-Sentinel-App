{
  "expo": {
    "name": "Spartans",
    "slug": "spartans",
    "scheme": "spartans",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clivebrownhill.spartans",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sentinel.schoolapp",
      "adaptiveIcon": {
        "backgroundColor": "#021F6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Spartans uses the camera to scan your student ID card and take your ID photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spartans needs your photos to pick your ID photo.",
          "cameraPermission": "Spartans uses the camera to take your ID photo."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Spartans tilts badges with your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A3A5C"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Spartans saves badge pictures to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#021F6B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "SpartansToday",
              "displayName": "Today's rotation",
              "description": "Day 1 or Day 2, the class that's on, a live countdown and what's next.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            },
            {
              "name": "SpartansClass",
              "displayName": "Class countdown",
              "description": "Your class and the time left in it, on the Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "SpartansHomework",
              "displayName": "Homework",
              "description": "What's still to do, soonest first.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "SpartansUpAhead",
              "displayName": "Up ahead",
              "description": "Days until the next day off, and what's coming up at school.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "74e475c1-509e-4a07-94ff-d1cd83a7dd39"
      }
    },
    "owner": "cliveb0s-team"
  }
}
